# Command used by msmtp to get the auth password

if [ $# -ne 1 ]; then
    echo "Usage $0 channel"
    exit 255
fi

CHANNEL=$1
NETFN=0C      # Transport
CMD=02        # CMD_GET_LAN_CONFIGURATION_PARAMETERS
LAN_PARM=C3   # SMTP Server Parameters
SMTP_PARM=03  # Auth Password
BS=00         # Block selector not used

# CC gets first byte; VC gets second (ignored); and PW gets remaining bytes.
# cmdtool gets hex encoded auth password.
# sed removes trailing nulls and adds a newline required by msmtp
read CC VC PW <<!
$(cmdtool -n 20 $NETFN $CMD $CHANNEL $LAN_PARM $SMTP_PARM $BS | sed '1s/\( 0\+\)* *$/ 0A/')
!

if [ $CC -eq 0 ]; then
    # Ascii encode
    echo "0000000 $PW" | xxd -r
fi

exit $CC
