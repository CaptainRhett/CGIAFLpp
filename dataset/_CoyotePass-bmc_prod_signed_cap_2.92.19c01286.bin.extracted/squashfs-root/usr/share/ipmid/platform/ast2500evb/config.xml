<!-- PIA Configuration XML for ast2500evb -->
<PIA>

	<driver_list>

		<driver_class driver_id="I2C_DRIVER">
			<!-- Physical BUS IDs start at 1 and can go to 14 max for the AST2500 
			 but we map them here starting at 0 since that is what the driver uses. -->	
		<I2C_driver_instance
			u8BusType="PHYSICAL"
			u8PrivateBusId="0"
			bMasterMode="TRUE"
			bSlaveMode="TRUE" />
		<I2C_driver_instance
			u8BusType="PHYSICAL"
			u8PrivateBusId="1"
			bMasterMode="TRUE"
			bSlaveMode="TRUE" />
		<I2C_driver_instance
			u8BusType="PHYSICAL"
			u8PrivateBusId="2"
			bMasterMode="TRUE"
			bSlaveMode="FALSE" />
		<I2C_driver_instance
			u8BusType="PHYSICAL"
			u8PrivateBusId="3"
			bMasterMode="TRUE"
			bSlaveMode="FALSE" />
		<I2C_driver_instance
			u8BusType="PHYSICAL"
			u8PrivateBusId="4"
			bMasterMode="TRUE"
			bSlaveMode="FALSE" />
		<I2C_driver_instance
			u8BusType="PHYSICAL"
			u8PrivateBusId="5"
			bMasterMode="TRUE"
			bSlaveMode="TRUE" />
		<I2C_driver_instance
			u8BusType="PHYSICAL"
			u8PrivateBusId="6"
			bMasterMode="TRUE"
			bSlaveMode="FALSE" />
		<I2C_driver_instance
			u8BusType="PHYSICAL"
			u8PrivateBusId="7"
			bMasterMode="TRUE"
			bSlaveMode="FALSE" />
		<I2C_driver_instance
			u8BusType="PHYSICAL"
			u8PrivateBusId="13"
			bMasterMode="TRUE"
			bSlaveMode="FALSE" />


		<!-- Logical BUS IDs start at 0 and can go to 31 max.
			   Logical busses 0-7 map directly to Physical busses 0-7 for ease of use. -->	
		<I2C_driver_instance
			u8BusType="LOGICAL"
			u8LogPrivateBusId="0"
			u8PhysicalBusId="0"
			u16MuxAddr="0"
			u16MuxData="0" />
		<I2C_driver_instance
			u8BusType="LOGICAL"
			u8LogPrivateBusId="1"
			u8PhysicalBusId="1"
			u16MuxAddr="0"
			u16MuxData="0" />
		<I2C_driver_instance
			u8BusType="LOGICAL"
			u8LogPrivateBusId="2"
			u8PhysicalBusId="2"
			u16MuxAddr="0"
			u16MuxData="0" />
		<I2C_driver_instance
			u8BusType="LOGICAL"
			u8LogPrivateBusId="3"
			u8PhysicalBusId="3"
			u16MuxAddr="0"
			u16MuxData="0" />
		<I2C_driver_instance
			u8BusType="LOGICAL"
			u8LogPrivateBusId="4"
			u8PhysicalBusId="4"
			u16MuxAddr="0"
			u16MuxData="0" />
		<I2C_driver_instance
			u8BusType="LOGICAL"
			u8LogPrivateBusId="5"
			u8PhysicalBusId="5"
			u16MuxAddr="0"
			u16MuxData="0" />
		<I2C_driver_instance
			u8BusType="LOGICAL"
			u8LogPrivateBusId="6"
			u8PhysicalBusId="6"
			u16MuxAddr="0"
			u16MuxData="0" />
		<I2C_driver_instance
			u8BusType="LOGICAL"
			u8LogPrivateBusId="7"
			u8PhysicalBusId="7"
			u16MuxAddr="0"
			u16MuxData="0" />
		<I2C_driver_instance
			u8BusType="LOGICAL"
			u8LogPrivateBusId="13"
			u8PhysicalBusId="13"
			u16MuxAddr="0"
			u16MuxData="0" />

		<!-- Muxed Logical BUS IDs can range from 15-31 and should go below here. -->

	</driver_class>

	<driver_class driver_id="LM75_DRIVER">
		<!-- the address below is the 7 bit i2c address left shifted by 1 bit as opposed to the
			 unshifted address used by the FRU instance -->
		<LM75_driver_instance 
			logical_bus="7"
			address="0x9a">
			<LM75_signal_offset 
				signal_id="BMCTemp"
				offset="0"
				bReadable="TRUE" />
		</LM75_driver_instance>
		<!-- Other driver instances go here -->
	</driver_class>

	<!-- The AST2500 has 232 gpio pins divided up between 29 ports, 8 pins per
		 port 0-7. The ports are designated A to Z and AA to AC numbered 0-28.
		 GPIOs are numbered 0 to 231 where the low order 3 three bits are the
		 number of the pin within the port and the higher order bits are the
		 port number. GPIOA0 is GPIO pin 0, GPIOB0 is GPIO pin 8, GPIOZ0 is
		 GPIO pin 200, and GPIOAB0 is GPIO pin 216. -->
	<driver_class driver_id="GPIO_DRIVER">
		<GPIO_driver_instance>
			<!-- The AST2500EVB does not have an LEDs, the GPIOs designated for
				 LEDs below are pins 1 and 2 on J7 -->
			<GPIO_signal_offset 
				signal_id="GreenStatusLEDSig"
				offset="GPIO_OFS_STAT_GRN_LED"
				u16PhysGpio="216"
				bfPowerState="PWRSTATE_ANY"
				bInput="0"
				bOutput="1" 
				bInverted="1"
				bInitVal="0"
				bOpenDrain="0" />
			<GPIO_signal_offset 
				signal_id="AmberStatusLEDSig"
				offset="GPIO_OFS_STAT_AMB_LED"
				u16PhysGpio="217"
				bfPowerState="PWRSTATE_ANY"
				bInput="0"
				bOutput="1" 
				bInverted="1"
				bInitVal="0"
				bOpenDrain="0" />
		</GPIO_driver_instance>
	</driver_class>

	<!-- The AST2500EVB has a number of voltage dividers that can provide input
		 to the ADC channels. This configuration assumes jumpers on J53 1,2 and
		 J52 1,2. Other channels can be used by changing the jumpers -->
	<driver_class driver_id="ADC_DRIVER">
		<ADC_driver_instance >
			<ADC_signal_offset signal_id="ADC0_CHAN0_READING"
				offset="ADC_OFS_CHAN0_READING"
				scale_factor="0x0B8D"
				poweron_only="0x00"/>
			<!-- other possible ADC inputs
			<ADC_signal_offset signal_id="ADC0_CHAN1_READING"
				offset="ADC_OFS_CHAN1_READING"
				poweron_only="0x00"/>
			<ADC_signal_offset signal_id="ADC0_CHAN2_READING"
				offset="ADC_OFS_CHAN2_READING"
				poweron_only="0x00"/>
			<ADC_signal_offset signal_id="ADC0_CHAN3_READING"
				offset="ADC_OFS_CHAN3_READING"
				poweron_only="0x00"/>
			<ADC_signal_offset signal_id="ADC0_CHAN4_READING"
				offset="ADC_OFS_CHAN4_READING"
				poweron_only="0x00"/>
			<ADC_signal_offset signal_id="ADC0_CHAN5_READING"
				offset="ADC_OFS_CHAN5_READING"
				poweron_only="0x00"/>
			<ADC_signal_offset signal_id="ADC0_CHAN6_READING"
				offset="ADC_OFS_CHAN6_READING"
				poweron_only="0x00"/>
			<ADC_signal_offset signal_id="ADC0_CHAN7_READING"
				offset="ADC_OFS_CHAN7_READING"
				scale_factor="0x0f71"
				poweron_only="0x00"/>
			<ADC_signal_offset signal_id="ADC0_CHAN8_READING"
				offset="ADC_OFS_CHAN8_READING"
				poweron_only="0x00"/>
			<ADC_signal_offset signal_id="ADC0_CHAN9_READING"
				offset="ADC_OFS_CHAN9_READING"
				poweron_only="0x00"/>
			<ADC_signal_offset signal_id="ADC0_CHAN10_READING"
				offset="ADC_OFS_CHAN10_READING"
				poweron_only="0x00"/>
			<ADC_signal_offset signal_id="ADC0_CHAN11_READING"
				offset="ADC_OFS_CHAN11_READING"
				poweron_only="0x00"/>
			<ADC_signal_offset signal_id="ADC0_CHAN12_READING"
				offset="ADC_OFS_CHAN12_READING"
				poweron_only="0x00"/>
			<ADC_signal_offset signal_id="ADC0_CHAN13_READING"
				offset="ADC_OFS_CHAN13_READING"
				poweron_only="0x00"/>
			<ADC_signal_offset signal_id="ADC0_CHAN14_READING"
				offset="ADC_OFS_CHAN14_READING"
				poweron_only="0x00"/>
			<ADC_signal_offset signal_id="ADC0_CHAN15_READING"
				offset="ADC_OFS_CHAN15_READING"
				poweron_only="0x00"/>
		   end alternate settings -->
		</ADC_driver_instance>
	</driver_class>

	<driver_class driver_id="VOLTAGE_FT_DRIVER">
		<VOLTAGE_ft_driver_instance >
			<VOLTAGE_ft_signal_offset signal_id="VOLTAGE_STATUS_FAULT"
				offset="VOLTAGE_FT_OFS_READING"/>
			<VOLTAGE_sensor adc_sig="ADC0_CHAN0_READING"
				is_dimm_sensor="0x00"
				event_offset="0x01"
				voltageName="+12V"/>
		</VOLTAGE_ft_driver_instance>
	</driver_class>

	<driver_class driver_id="PWMTACH_DRIVER">
		<PWMTACH_driver_instance>

			<!-- Tach Signals -->
			<PWMTACH_signal_offset
				signal_id="Fan00Sig"
				offset="PTOFS_TACH_00"
				eDevType="TACH"
				u8PowerState="PWRSTATE_ANY"
				eTachNum="TACH_00"
				eTachPwmNum="PWM_0"
				u16MinRPM="1000" />

			<!-- PWM Signals -->
			<PWMTACH_signal_offset
				signal_id="FanDomain0Sig"
				offset="PTOFS_PWM_0"
				eDevType="PWM"
				u8PowerState="PWRSTATE_ANY"
				ePwmNum="PWM_0"
				u16DefaultValue="50" />	<!-- 50 + 5*offset -->
		</PWMTACH_driver_instance>
	</driver_class>

	<!-- The intrinsic driver must be the last one! -->
	<driver_class driver_id="INTRINSIC_DRIVER">
		<intrinsic_driver_instance >
			<intrinsic_signal_offset signal_id="INT_PS_PWR_GOOD"
				offset="INT_PS_PWR_GOOD_OFFSET"
				u32SignalId="PSPwrGoodSig" />
			<intrinsic_signal_offset signal_id="INT_POST_COMPLETE"
				offset="INT_POST_COMPLETE_OFFSET"
				u32SignalId="PostComplete" />
		</intrinsic_driver_instance>
		<!-- There is only 1 Intrinsic driver instance! -->
	</driver_class>
</driver_list>

<!-- Entities are containers for sensors and effectors -->
<entity_list>

	<!-- Baseboard sensors, sensor events, and Effectors-->

	<entity entity_id="Baseboard_Entity">
		<sensor	sensor_id="BMC12VOLT"
			signal_id="ADC0_CHAN0_READING"
			u16ScanPeriodMs="1000"
			u8Class="0"
			u16IPMISensorNumber="0xD0"
			u8ScaleViaSDR="0"
			u16ErrorThreshold="0">

			<core_flags bScannable="TRUE"
				bScanEnable="TRUE"
				bTimeStamping="FALSE"
				bNVStorage="FALSE"
				/>

			<ipmi_flags bManuallyRearmed="FALSE"
				bEdgeTriggered="TRUE"
				bSigned="FALSE"
				/>

			<sensor_event event_id="BMC12VSensorUNR"
				signal_id="0"
				SensorEventType="0"
				u8AssertionSeverity="FAULT_CRITICAL"
				u8DeassertionSeverity="FAULT_NONE">

				<threshold_settings u8ThresholdType="UPP_NRE"/>

			</sensor_event>

			<sensor_event event_id="BMC12VSensorUCR"
				signal_id="0"
				SensorEventType="0"
				u8AssertionSeverity="FAULT_CRITICAL"
				u8DeassertionSeverity="FAULT_NONE">

				<threshold_settings u8ThresholdType="UPP_CRE"/>

			</sensor_event>

			<sensor_event event_id="BMC12VSensorUNC"
				signal_id="0"
				SensorEventType="0"
				u8AssertionSeverity="FAULT_CRITICAL"
				u8DeassertionSeverity="FAULT_NONE">

				<threshold_settings u8ThresholdType="UPP_NCR"/>

			</sensor_event>

			<sensor_event event_id="BMC12VSensorLNC"
				signal_id="0"
				SensorEventType="0"
				u8AssertionSeverity="FAULT_CRITICAL"
				u8DeassertionSeverity="FAULT_NONE">

				<threshold_settings u8ThresholdType="LOW_NCR"/>

			</sensor_event>

			<sensor_event event_id="BMC12VSensorLCR"
				signal_id="0"
				SensorEventType="0"
				u8AssertionSeverity="FAULT_CRITICAL"
				u8DeassertionSeverity="FAULT_NONE">

				<threshold_settings u8ThresholdType="LOW_CRE"/>

			</sensor_event>

			<sensor_event event_id="BMC12VSensorLNR"
				signal_id="0"
				SensorEventType="0"
				u8AssertionSeverity="FAULT_CRITICAL"
				u8DeassertionSeverity="FAULT_NONE">

				<threshold_settings u8ThresholdType="LOW_NRE"/>

			</sensor_event>

		</sensor>
		<sensor	sensor_id="EventLoggingDisabled"
			u16ScanPeriodMs="0"
			u8Class="DISCRETE_SEN"
			u16IPMISensorNumber="0x07"
			>
			<core_flags bScannable="FALSE"
				bScanEnable="TRUE" />
			

			<sensor_event event_id="EvtLogCleared"
				signal_id="NULL_ID"
				SensorEventType="DISCRETE_SEN"
				u8AssertionSeverity="FAULT_NONE"
				u8DeassertionSeverity="FAULT_NONE">
				<discrete_settings
					u8DiscreteOffset="2"
					bInitValue="FALSE"
					bDoInit="TRUE"
					bPolarity="FALSE" />
			</sensor_event>
		</sensor>

		<sensor sensor_id="IPMI_Watchdog"
			u16ScanPeriodMs="0"
			u8Class="DISCRETE_SEN"
			u16IPMISensorNumber="0x03"
			>
			<core_flags bScannable="FALSE"
				bScanEnable="FALSE"
				bTimeStamping="TRUE"
				bNVStorage="TRUE" />
			

			<sensor_event event_id="Watchdog_TimerExpired"
				signal_id="NULL_ID"
				SensorEventType="DISCRETE_SEN"
				u8AssertionSeverity="FAULT_NONE"
				u8DeassertionSeverity="FAULT_NONE">
				<discrete_settings
					u8DiscreteOffset="0"
					bInitValue="FALSE"
					bDoInit="TRUE"
					bPolarity="FALSE" />
			</sensor_event>
			<sensor_event event_id="Watchdog_HardReset"
				signal_id="NULL_ID"
				SensorEventType="DISCRETE_SEN"
				u8AssertionSeverity="FAULT_NONE"
				u8DeassertionSeverity="FAULT_NONE">
				<discrete_settings
					u8DiscreteOffset="1"
					bInitValue="FALSE"
					bDoInit="TRUE"
					bPolarity="FALSE" />
			</sensor_event>
			<sensor_event event_id="Watchdog_PowerDown"
				signal_id="NULL_ID"
				SensorEventType="DISCRETE_SEN"
				u8AssertionSeverity="FAULT_NONE"
				u8DeassertionSeverity="FAULT_NONE">
				<discrete_settings
					u8DiscreteOffset="2"
					bInitValue="FALSE"
					bDoInit="TRUE"
					bPolarity="FALSE" />
			</sensor_event>
			<sensor_event event_id="Watchdog_PowerCycle"
				signal_id="NULL_ID"
				SensorEventType="DISCRETE_SEN"
				u8AssertionSeverity="FAULT_NONE"
				u8DeassertionSeverity="FAULT_NONE">
				<discrete_settings
					u8DiscreteOffset="3"
					bInitValue="FALSE"
					bDoInit="TRUE"
					bPolarity="FALSE" />
			</sensor_event>
			<sensor_event event_id="Watchdog_TimerInterrupt"
				signal_id="NULL_ID"
				SensorEventType="DISCRETE_SEN"
				u8AssertionSeverity="FAULT_NONE"
				u8DeassertionSeverity="FAULT_NONE">
				<discrete_settings
					u8DiscreteOffset="8"
					bInitValue="FALSE"
					bDoInit="TRUE"
					bPolarity="FALSE" />
			</sensor_event>
		</sensor>

		<sensor sensor_id="BMCHW_Watchdog"
			signal_id="0"
			u16ScanPeriodMs="0"
			u8Class="DISCRETE_SEN"
			u16IPMISensorNumber="0x0A"
			>

			<core_flags bScannable="FALSE"
				bScanEnable="FALSE"
				bTimeStamping="FALSE"
				bNVStorage="FALSE"
				/>

			<ipmi_flags bManuallyRearmed="FALSE"
				bEdgeTriggered="FALSE"
				bSigned="FALSE"
				bRearmPersistState="TRUE"/>

			<sensor_event event_id="BMC_WDT_Asserted"
				signal_id="NULL_ID"
				SensorEventType="DISCRETE_SEN"
				u8AssertionSeverity="FAULT_NON_CRITICAL"
				u8DeassertionSeverity="FAULT_NONE">
				<discrete_settings u8DiscreteOffset="1"
					bInitValue="FALSE"
					bDoInit="TRUE"
					bPolarity="FALSE"
					bInverted="FALSE" />
			</sensor_event>
		</sensor>

		<sensor	sensor_id="BMCTemperature"
			signal_id="BMCTemp"
			u16ScanPeriodMs="1000"
			u8Class="0"
			u16IPMISensorNumber="0x22"
			u8ScaleViaSDR="0">
			<core_flags bScannable="TRUE"
				bScanEnable="TRUE"
				bTimeStamping="FALSE"
				bNVStorage="FALSE"
				/>
			<ipmi_flags bManuallyRearmed="FALSE"
				bEdgeTriggered="TRUE"
				bSigned="TRUE"
				/>
		</sensor>

		<sensor	sensor_id="Fan00Sensor"
			signal_id="Fan00Sig"
			u16ScanPeriodMs="500"
			u8Class="0"
			u16IPMISensorNumber="0x30"
			u8ScaleViaSDR="0">
			<core_flags bScannable="TRUE"
				bScanEnable="TRUE"
				bTimeStamping="FALSE"
				bNVStorage="FALSE"
				/>
			<ipmi_flags bManuallyRearmed="FALSE"
				bEdgeTriggered="TRUE"
				bSigned="FALSE"
				/>

			<sensor_event event_id="Fan00SensorLNR"
				u8AssertionSeverity="FAULT_NON_RECOVERABLE">
				<threshold_settings u8ThresholdType="LOW_NRE"
					s8Threshold="10" />
			</sensor_event>
			<sensor_event event_id="Fan00SensorLC"
				u8AssertionSeverity="FAULT_CRITICAL">
				<threshold_settings u8ThresholdType="LOW_CRE"
					s8Threshold="10" />
			</sensor_event>
			<sensor_event event_id="Fan00SensorLNC"
				u8AssertionSeverity="FAULT_NON_CRITICAL">
				<threshold_settings u8ThresholdType="LOW_NCR"
					s8Threshold="10" />
			</sensor_event>
		</sensor>

		<sensor	sensor_id="MgmtHealthSensor"
			signal_id="0"
			u16ScanPeriodMs="0"
			u8Class="DISCRETE_SEN"
			u16IPMISensorNumber="0x10"
			u16ErrorThreshold="0">


			<core_flags bScannable="FALSE"
				bScanEnable="TRUE"
				bTimeStamping="FALSE"
				bNVStorage="FALSE"
				/>


			<ipmi_flags bManuallyRearmed="FALSE"
				bEdgeTriggered="FALSE"
				bSigned="FALSE"
				/>


			<sensor_event event_id="Sensor_Failure"
				signal_id="NULL_ID"
				SensorEventType="DISCRETE_SEN"
				u8AssertionSeverity="FAULT_NON_CRITICAL"
				u8DeassertionSeverity="FAULT_NONE">

				<discrete_settings u8DiscreteOffset="4"
					bInitValue="FALSE"
					bDoInit="TRUE"
					bPolarity="FALSE"
					bInverted="FALSE"/>

			</sensor_event>

		</sensor>

		<sensor	sensor_id="VoltageFault"
			signal_id="VOLTAGE_STATUS_FAULT"
			u16ScanPeriodMs="1000"
			u8Class="DISCRETE_SEN"
			u16IPMISensorNumber="0xD1"
			u16ErrorThreshold="0">


			<core_flags bScannable="TRUE"
				bScanEnable="TRUE"
				bTimeStamping="FALSE"
				bNVStorage="FALSE"
				/>


			<ipmi_flags bManuallyRearmed="FALSE"
				bEdgeTriggered="FALSE"
				bSigned="FALSE"
				/>


			<sensor_event event_id="VoltageFaultAsserted"
				signal_id="NULL_ID"
				SensorEventType="DISCRETE_SEN"
				u8AssertionSeverity="FAULT_CRITICAL"
				u8DeassertionSeverity="FAULT_NONE">

				<discrete_settings u8DiscreteOffset="1"
					bInitValue="FALSE"
					bDoInit="TRUE"
					bPolarity="FALSE"
					bInverted="FALSE"/>
			</sensor_event>
		</sensor>

		<FRU_instance u32Key="FRU_ID"
			u8DeviceId="0x00"
			u8I2CBusID="0"
			u8I2CSlaveAddress="0"
			u8DeviceType="0"
			u16StartAdrs="0"
			u16FruLength="0x2000"
			Type="FRU_FLASH"
			bPresent="1"
			IsInternalFRU="0"
			u8FruInstance="0"
			WriteEnable="1"/>

		<!-- the I2c address below is the unshifted 7 bit address as opposed to the 7 bit address
			 left shifted 1 bit used by the LM75 driver --> 
		<FRU_instance u32Key="FRU_ID"
			u8DeviceId="4"
			u8I2CBusID="3"
			u8I2CSlaveAddress="0x50"
			u8DeviceType="0xA"
			u16StartAdrs="0"
			u16FruLength="0x0100"
			Type="FRU_EEPROM"
			bPresent="1"
			IsInternalFRU="0"
			u8FruInstance="0"
			WriteEnable="1"  />

		<!-- An effector is something that has one or more actions -->
		<effector2 effector_id="StatusLED"
			signal_id="GreenStatusLEDSig"
			signal_id2="AmberStatusLEDSig"
			u32DefaultState="StatusLED_Solid_Green"
			u32EffectorEventType="EVT_EFFECTOR_LED" >
			<effector_action2 effectoraction_id="StatusLED_Solid_Green"
				u8Priority="1"
				u32EffectorValue="LED_ON"
				u32EffectorValue2="LED_OFF" />
			<effector_action2 effectoraction_id="StatusLED_Blink_Green"
				u8Priority="2"
				u32EffectorValue="LED_BLINK"
				u32EffectorValue2="LED_OFF" />
			<effector_action2 effectoraction_id="StatusLED_Blink_Amber"
				u8Priority="3"
				u32EffectorValue="LED_OFF"
				u32EffectorValue2="LED_BLINK" />
			<effector_action2 effectoraction_id="StatusLED_Solid_Amber"
				u8Priority="4"
				u32EffectorValue="LED_OFF"
				u32EffectorValue2="LED_ON" />
		</effector2>
	</entity>

</entity_list>

<!-- Management Health Associations -->
<association event_id="Sensor_Failure"
	effectoraction_id="StatusLED_Blink_Green"
	u8AssociationType="ASSOC_SENSOR_EVENT_TO_EFFECTOR_ACTION" />

<!-- Module config records -->
<moduleconfig>
    <sessionconfig u32Key="SESSION_MGR_ID"
			   u32SessAuditSensorId="0"
               u8MinPasswdLen="6"
               bAllowOemPriv="0" />

	<selconfig u32Key="SEL_ID"
		u32EvtLogDisableSensorId="EventLoggingDisabled"
		u16MaxEntriesSupported="2700"/>

	<fwupdconfig u32Key="FWUPDATE_ID"
		u16FwUpdateSensorNum="0x12"
		u16FwSecuritySensorNum="0x1A" />

	<ipmbconfig u32Key="IPMB_ID"
