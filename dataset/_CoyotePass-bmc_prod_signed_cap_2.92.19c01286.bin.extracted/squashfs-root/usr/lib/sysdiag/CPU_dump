#       cp $STAGING_LOCATION/$CPUDUMP_JSON_TMP_NAME "$ADV_STAGING_LOCATION/`basename $i .zip`.txt"
#    fi
# done

# Unzip the JSON CPU dump files into the advanced and basic staging locations with the zip name
# for i in $CPUDUMP_LOCATION/$CPUDUMP_JSON_NAME*.zip
# do
#    if [ -e $i ]
#    then
#       unzip -o $i -d $STAGING_LOCATION
#       cp $STAGING_LOCATION/$CPUDUMP_JSON_TMP_NAME "$ADV_STAGING_LOCATION/`basename $i .zip`.json"
#       cp $STAGING_LOCATION/$CPUDUMP_JSON_TMP_NAME "$BASIC_STAGING_LOCATION/`basename $i .zip`.json"
#    fi
# done

if [ -e /tmp/crashdump.log ]
then
    cp /tmp/crashdump.log $BASIC_STAGING_LOCATION/
    cp /tmp/crashdump.log $ADV_STAGING_LOCATION/
else
    echo "/tmp/crashdump.log not exists."
fi

cp $CRASHDUMP_LOCATION/*.json $BASIC_STAGING_LOCATION/
cp $CRASHDUMP_LOCATION/*.json $ADV_STAGING_LOCATION/

EndHtmlSections

