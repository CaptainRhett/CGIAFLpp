#!/bin/sh

NAME=snmpd

cmd=$1
do_reload=$2
CONFIG="/tmp/monit.d/100-snmpd.conf"

rc=1
case $cmd in 
start|restart)
    if [ ! -f $CONFIG ] || [ -n "$do_reload" ]; then
        /etc/init.d/monit reload $NAME
        usleep 1500000
    fi
    monitored=$(monit status $NAME 2>/dev/null | grep -c Process)
    if [ $monitored -ne 0 ]; then
        monit $cmd $NAME
        rc=$?
    fi
    ;;
stop)
    monitored=$(monit status $NAME 2>/dev/null | grep -c Process)
    if [ $monitored -ne 0 ]; then
        monit stop $NAME
        rc=$?
    fi
    ;;
status)
    monit status $NAME
    rc=$?
    ;;
*)
    echo "Usage: $0 start [do_reload]|stop|restart [do_reload]|status"
    rc=2
    ;;
esac

if [ $rc -ne 0 ]; then
    /etc/monit/scripts/$NAME-init $cmd
    rc=$?
fi

exit $rc
