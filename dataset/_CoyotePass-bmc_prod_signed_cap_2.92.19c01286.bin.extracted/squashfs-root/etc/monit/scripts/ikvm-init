NAME=ikvmserver
DAEMON=/usr/bin/${NAME}
PID_FILE=/var/run/${NAME}.pid
LOG_TAG=ikvm-init
LOG_CFG=/nv/daemon-log.cfg
LOGEXEC=/etc/monit/scripts/log-exec.sh
IKVM_LOG=/var/log/${NAME}.log
IKVM_LOG_EN=0
if [ -f $LOG_CFG ]; then
    IKVM_LOG_EN=$(grep -c "^IKVM_LOG_EN=1" $LOG_CFG)
fi

start() {
    # setup bmc's tls keys
    /usr/httpd/crt.sh

    ENABLED=$(sed -n 's/IKVM=\([0-2]\).*$/\1/p' /nv/service.conf)
    if [ $ENABLED -eq 0 ]; then
        monit unmonitor ikvmserver
        logger -t $LOG_TAG -p local0.info "$NAME is disabled in /nv/service.conf - unmonitoring $DAEMON"
        return 1
    fi
    logger -t "$LOG_TAG" -p local0.info "Starting BMC Service $NAME"
    if [ $(ps | grep -c "[i]kvmserver") -eq 0 ]; then
        if [ $IKVM_LOG_EN -eq 1 ]; then
            /sbin/start-stop-daemon -S -p $PID_FILE -m -b -x $LOGEXEC -- -l $IKVM_LOG -e $DAEMON && return 0
        else
            /sbin/start-stop-daemon -S -p $PID_FILE -m -b -x $DAEMON && return 0
        fi
        rc=$?
        reason="Unable to execute $DAEMON; rc: $rc"
    else
        reason="ikvmserver is already running"
        echo $reason
    fi
    logger -t "$LOG_TAG" -p local0.info "Failed to start $NAME: $reason"
    return 1
}    

stop() {
    logger -t "$LOG_TAG" -p local0.info "Shutting down BMC Service $NAME"
    for signal in 9; do
        /sbin/start-stop-daemon -K -s $signal -p $PID_FILE
        sleep 1
        if [ $(ps | grep -c "[i]kvmserver") -ne 0 ]; then
            killall -$signal $NAME
            sleep 1
        fi
        if [ $(ps | grep -c "[i]kvmserver") -eq 0 ]; then
            logger -t "$LOG_TAG" -p local0.info "Successful shutdown of BMC Service $NAME"
            return 0
        fi
    done
    logger -t "$LOG_TAG" -p local0.info "Failed to stop $NAME; $(ps | grep '[i]kvmserver')"
    return 1
}

case "$1" in
    start)
    start
    ;;
    stop)
    stop
    ;;
    status)
    echo "Checking ikvmserver status: "
    ps | grep "[i]kvmserver" || echo "stopped"
    ;;
    restart)
    stop
    start
    ;;
    *)
    echo "Usage: ikvmserver {start|stop|status|restart}"
    exit 1
    ;;
esac
exit $?
