#!/bin/sh

NAME=raidsvc
DAEMON=/usr/bin/RAIDService
PID_FILE=/var/run/${NAME}.pid
LOG_TAG=${NAME}-init
PARMS="-f"

start() {
    #ENABLED=$(sed -n 's/RAIDSVC=\([0-2]\).*$/\1/p' /nv/service.conf)
    #if [ $ENABLED -eq 0 ]; then
    #    monit unmonitor $NAME
    #    logger -t $LOG_TAG -s -p user.info "$NAME is disabled in /nv/service.conf - unmonitoring $DAEMON"
    #    return 1
    #fi
    if [ $(ps | grep -c "[R]AIDService$") -eq 0 ]; then
        logger -t "$LOG_TAG" -p local0.info "Starting $NAME"
        /sbin/start-stop-daemon -S -p $PID_FILE -m -b -x $DAEMON -- $PARMS && return 0
        rc=$?
        reason="Unable to execute $DAEMON; rc: $rc"
    else
        reason="$NAME is already running"
    fi
    logger -t "$LOG_TAG" -p local0.info "Failed to start $NAME: $reason"
    return 1
}    

stop() {
    logger -t "$LOG_TAG" -p local0.info "Shutting down $NAME"
    for signal in 15; do
        /sbin/start-stop-daemon -K -s $signal -p $PID_FILE
        sleep 5
        if [ $(ps | grep -c "[R]AIDService$") -ne 0 ]; then
            killall -$signal $NAME
            sleep 5
        fi
        if [ $(ps | grep -c "[R]AIDService$") -eq 0 ]; then
            return 0
        fi
    done
    logger -t "$LOG_TAG" -p local0.info "Failed to stop $NAME; $(ps | grep '[R]AIDService$')"
    return 1
}

case "$1" in
    start)
    start
    rc=$?
    ;;
    stop)
    stop
    rc=$?
    ;;
    status)
    echo "Checking $NAME status: "
    ps | grep "[R]AIDService" || echo "stopped"
    rc=$?
    ;;
    restart)
    stop
    start
    rc=$?
    ;;
    *)
    echo "Usage: RAIDService {start|stop|status|restart}"
    exit 1
    ;;
esac
exit $rc
