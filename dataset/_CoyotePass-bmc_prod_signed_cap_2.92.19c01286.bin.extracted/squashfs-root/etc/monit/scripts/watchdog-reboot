LOG_TAG=watchdog-reboot
SAVELOGS=/nv/savelogs
CURRENT=$SAVELOGS/01.dump

killall -9 watchdog
MSG="Initiated Watchdog BMC reset; harvesting logs"
logger -t "$LOG_TAG" -p local0.info "$MSG"
echo $MSG >/dev/console
logger -t "$LOG_TAG" -p local0.info "$MONIT_SERVICE: $MONIT_DESCRIPTION"

# Unmonitor this service so that this doesn't repeat.
monit unmonitor $MONIT_SERVICE

rm -rf $SAVELOGS/03.dump
mv $SAVELOGS/02.dump $SAVELOGS/03.dump 2>/dev/null
mv $CURRENT $SAVELOGS/02.dump 2>/dev/null
mkdir -p $CURRENT
/usr/bin/rotate-log.sh /var/log/ipmid.log
cp /var/log/ipmid*gz $CURRENT
gzip -c /var/log/messages > $CURRENT/messages.gz
dmesg | gzip -c > $CURRENT/dmesg.gz

echo "---------------------------------------" > /dev/console
echo "Last 100 lines of dmesg"                 > /dev/console
echo "---------------------------------------" > /dev/console
dmesg | tail -100 > /dev/console

echo "---------------------------------------" > /dev/console
echo "Last 100 lines of /var/log/messages"     > /dev/console
echo "---------------------------------------" > /dev/console
tail -100 /var/log/messages > /dev/console 

echo -n "----------------------------------------" > /dev/console
echo    "----------------------------------------" > /dev/console
echo    "$MONIT_SERVICE: $MONIT_DESCRIPTION"       > /dev/console
timeout=$(sed -n 's/Timeout: //p' /proc/wdt)
echo    "WDT reset in $timeout seconds."           > /dev/console
echo -n "----------------------------------------" > /dev/console
echo    "----------------------------------------" > /dev/console
