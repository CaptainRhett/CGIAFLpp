usage()
{
    echo "Usage $0 [-n|-c|-b] fsname"
    echo "-b: print block device name matching fsname"
    echo "-c: print character device name matching fsname"
    echo "-n: (default) print mtd name matching fsname"
    echo "where fsname is a tag in /proc/mtd"
    exit 255
}

op=n
if [ $# -eq 2 ]; then
    case "$1" in
    "-b") op="b";;
    "-c") op="c";;
    "-n") op="n";;
    *) usage;;
    esac
    shift
fi

if [ $# -ne 1 ]; then
    usage
fi

fsname=$1
mtdname=`sed -n "/\"$fsname\"/s/:.*$//p" /proc/mtd`
if [ -z "$mtdname" ]; then
    echo "Cannot find $fsname in /proc/mtd"
    usage
fi

case "$op" in
"b") echo /dev/$mtdname | sed 's/mtd/mtdblock/';;
"c") echo /dev/$mtdname;;
"n") echo $mtdname;;
esac
exit 0
