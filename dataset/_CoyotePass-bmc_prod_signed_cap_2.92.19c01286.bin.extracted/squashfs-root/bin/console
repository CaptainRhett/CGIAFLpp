RELEASE_FILE=/etc/bmc-release

if [ -f $RELEASE_FILE ]; then
    . /etc/bmc-release
else
    BUILD_TYPE=release
fi

. /etc/init.d/platform-common

eval $(get_platform_config)

# If /nv/force-release exists, treat as though it is a production build.
if [ "$IS_REFERENCE_BOARD" = 1 -o "$BUILD_TYPE" = "dev" -a ! -f /nv/force-release ]; then
    # Development build or reference board; no login required.
    exec /bin/sh
else
    # Non-Development build; login is required.
    exec /sbin/getty -w -i 115200 ttyS0
fi
