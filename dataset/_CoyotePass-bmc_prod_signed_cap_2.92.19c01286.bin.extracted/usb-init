# Get common functions (advance_feature_available)

source /etc/monit/scripts/common-funcs

NAME=usb
DAEMON=/usr/bin/$NAME
PID_FILE=/var/run/$NAME.pid
LOG_TAG="usb-init"
LOGEXEC=/etc/monit/scripts/log-exec.sh
USB_LOG=/var/log/${NAME}.log
LOG_CFG=/nv/daemon-log.cfg
USB_LOG_EN=0
if [ -f $LOG_CFG ]; then
    USB_LOG_EN=$(grep -c "^USB_LOG_EN=1" $LOG_CFG)
fi

start() {
    # setup bmc's tls keys
    /usr/httpd/crt.sh

    ENABLED=$(sed -n 's/USB=\([0-1]\).*$/\1/p' /nv/service.conf)
    if [ -z $ENABLED ]; then
        ENABLED="1"
    fi
    if [ $(ps | grep -c '[u]sb$') -eq 0 ]; then
        if advance_feature_available; then
            if [ $ENABLED -eq 1 ]; then
                OPTS=""
            else
                OPTS="-l"
            fi
        else
            OPTS="-l"
        fi
        logger -t "$LOG_TAG" -p local0.info "Starting BMC Service $NAME $OPTS"

        if [ $USB_LOG_EN -eq 1 ]; then
            /sbin/start-stop-daemon -S -p $PID_FILE -m -b -x $LOGEXEC -- -l $USB_LOG -e $DAEMON -- $OPTS && return 0
        else
            /sbin/start-stop-daemon -S -p $PID_FILE -m -b -x $DAEMON -- $OPTS && return 0
        fi
        rc=$?
        reason="Unable to execute $DAEMON; rc: $rc"
    else
        reason="$NAME daemon is already running"
    fi
    logger -t "$LOG_TAG" -p local0.info "Failed to start $NAME; $reason"
    return 1
}

stop() {
    logger -t "$LOG_TAG" -p local0.info "Shutting down BMC Service $NAME"
    for signal in 15 9; do
        /sbin/start-stop-daemon -K -s $signal -p $PID_FILE
        sleep 1
        pid=$(ps | grep '[u]sb$' | awk '{print $1}')
        if [ -n "$pid" ]; then
            kill -$signal $pid
            sleep 1
        fi
        if [ $(ps | grep -c '[u]sb$') -eq 0 ]; then
            logger -t "$LOG_TAG" -p local0.info "Successful shutdown of BMC Service $NAME"
            return 0
        fi
    done
    logger -t "$LOG_TAG" -p local0.info "Failed to stop $NAME: $(ps | grep '[s]sb$')"
    return 1
}

case "$1" in
    start)
    start
    ;;
    stop)
    stop
    ;;
    status)
    echo "Checking $NAME daemon status: "
    ps | grep '[u]sb$' || echo "stopped"
    ;;
    restart)
    stop
    start
    ;;
    *)
    echo "Usage: $0 {start|stop|status|restart}"
    exit 1
    ;;
esac
exit $?
