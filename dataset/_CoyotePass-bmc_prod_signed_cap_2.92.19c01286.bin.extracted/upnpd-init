NAME=upnp_dev
DAEMON=/usr/bin/${NAME}
PID_FILE=/var/run/${NAME}.pid
LOG_TAG=upnpd-init
LOG_CFG=/nv/daemon-log.cfg
LOGEXEC=/etc/monit/scripts/log-exec.sh
UPNP_LOG=/var/log/${NAME}.log
UPNP_LOG_EN=0

if [ -f $LOG_CFG ]; then
    UPNP_LOG_EN=$(grep -c "^UPNP_LOG_EN=1" $LOG_CFG)
fi

start() {
    ENABLED=$(sed -n 's/UPNPD=\([0|1]\).*$/\1/p' /nv/service.conf)
    if [ $ENABLED -eq 0 ]; then
        monit unmonitor upnp_dev
        logger -t $LOG_TAG -p local0.info "$NAME is disabled in /nv/service.conf - unmonitoring $DAEMON"
        return 1
    fi
    logger -t "$LOG_TAG" -p local0.info "Starting BMC Service $NAME"
    if [ $(ps | grep -c "[u]pnp_dev") -eq 0 ]; then
        if [ $UPNP_LOG_EN -eq 1 ]; then
            /sbin/start-stop-daemon -S -p $PID_FILE -m -b -x $LOGEXEC -- -l $UPNP_LOG -e $DAEMON && return 0
        else
            /sbin/start-stop-daemon -S -p $PID_FILE -m -b -x $DAEMON && return 0
        fi
        rc=$?
        reason="Unable to execute $DAEMON; rc: $rc"
    else
        reason="UPNP is already running"
        echo $reason
    fi
    logger -t "$LOG_TAG" -p local0.info "Failed to start $NAME: $reason"
    return 1
}

stop() {
    logger -t "$LOG_TAG" -p local0.info "Shutting down BMC Service $NAME"
    for signal in 9; do
        /sbin/start-stop-daemon -K -s $signal -p $PID_FILE
        sleep 1
        if [ $(ps | grep -c "[u]pnp_dev") -ne 0 ]; then
            killall -$signal $NAME
            sleep 1
        fi
        if [ $(ps | grep -c "[u]pnp_dev") -eq 0 ]; then
            logger -t "$LOG_TAG" -p local0.info "Successful shutdown of BMC Service $NAME"
            return 0
        fi
    done
    logger -t "$LOG_TAG" -p local0.info "Failed to stop $NAME; $(ps | grep '[u]pnp_dev')"
    return 1
}

case "$1" in
    start)
    start
    ;;
    stop)
    stop
    ;;
    status)
    echo "Checking UPNP status: "
    ps | grep "[u]pnp_dev" || echo "stopped"
    ;;
    restart)
    stop
    start
    ;;
    *)
    echo "Usage: UPNP {start|stop|status|restart}"
    exit 1
    ;;
esac
exit $?
