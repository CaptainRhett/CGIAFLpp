#!/bin/sh

NAME=upnp_dev

cmd=$1
CONFIG="/tmp/monit.d/078-upnpd.conf"

rc=1
case $cmd in
start|restart)
    if [ ! -f $CONFIG ]; then
        /etc/init.d/monit reload upnpd
        usleep 1000000
    fi
    monitored=$(monit status $NAME 2>/dev/null | grep -c Process)
    if [ $monitored -ne 0 ]; then
        monit $cmd $NAME
        rc=$?
    fi
    ;;
stop)
    monitored=$(monit status $NAME 2>/dev/null | grep -c Process)
    if [ $monitored -ne 0 ]; then
        monit stop $NAME
        rc=$?
    fi
    ;;
status)
    monit status $NAME
    rc=$?
    ;;
*)
    echo "Usage: $0 start|stop|status|restart"
    exit 1
    ;;
esac

if [ $rc -ne 0 ]; then
    /etc/monit/scripts/upnpd-init $cmd
    rc=$?
fi

exit $?
