NAME=ipmidSafe
DAEMON=/usr/bin/$NAME
PID_FILE=/var/run/$NAME.pid
LOG_FILE=/var/log/ipmid.log
LOG_TAG=ipmid-safe-init

get_running_pids() {
    cnt=0
    for pid in $(/bin/ps | awk '$5 ~ /(^|\/)ipmidSafe$/ {print $1}'); do
        exe=$(get_exe_path $pid)
        # ignore script named *ipmidSafe* which will have an exe linked to busybox
        case $exe in
          *busybox*|*vi*|*sh*|"")
             continue
             ;;
          *) ;;
        esac
        echo \"$exe\" "$pid"
        cnt=$((cnt+1))
    done
    return $cnt
}

get_exe_path() {
    rc=2
    pid="$1"
    if [ -e /proc/$pid/exe ]; then
        ls -l /proc/$pid/exe | sed 's/^.*-> //' 2>/dev/null
        rc=0
    elif [ -e /proc/$pid/stat ]; then
        sed 's/^.*(\(.*\)).*$/\1/' /proc/$pid/stat
        rc=0
    fi
    return $rc
}

start_ipmi() {
    TMP_PID=/tmp/start_ipmi$$
    rm -f ${TMP_PID}*
    if [ -f $PID_FILE ]; then
        start_stop_pid=$(cat $PID_FILE 2>/dev/null)
        record_progress=0
    else
        record_progress=1
        start_stop_pid=0
    fi
    set -o pipefail
    get_running_pids | while read exe pid; do
        echo "$exe is already running as pid $pid"

        # Since in a subshell, cannot exit loop with a modified variable so
        # store some things in temp files.
        if [ "$start_stop_pid" = "$pid" ]; then
            touch ${TMP_PID}.found
        else
            echo $pid > ${TMP_PID}.nomatch
        fi
    done
    rc=$? # get_running_pids returns number processes found
    if [ $rc -eq 0 ]; then
        # ipmidSafe is not running, start it.

        if [ $record_progress -eq 1 ]; then
            # Record boot progress that we are starting ipmidSafe
            /usr/bin/boot_progress.sh MB_RUNTM_IPMID_START
        fi

        logger -t "$LOG_TAG" -p local0.info "Starting $NAME"
        $DAEMON -d -p $PID_FILE -l $LOG_FILE
        rc=$?
        if [ $rc -eq 0 -a $record_progress -eq 1 ]; then
            /usr/bin/boot_progress.sh MB_RUNTM_IPMID_STARTED
        elif [ $rc -ne 0 ]; then
            logger -t "$LOG_TAG" -p local0.info "Failed to start $NAME; rc:$rc"
        fi
    else
        logger -t "$LOG_TAG" -p local0.info "Failed to start $NAME; $NAME is already running as PID $pid"
        if [ ! -f ${TMP_PID}.found -a -f ${TMP_PID}.nomatch ]; then
            # ipmidSafe is running but $PID_FILE does not have the correct id of the
            # running process which will confuse monit. Put the correct value there.
            mv ${TMP_PID}.nomatch ${PID_FILE}
        fi
    fi
    rm -f ${TMP_PID}*
    return $rc
}

stop_ipmi() {
    # There should only be one process, but in case
    # one was started mistakenly, kill them all.

    start_stop_pid=$(cat $PID_FILE 2>/dev/null)

    logger -t "$LOG_TAG" -p local0.info "Stopping $NAME"
    set -o pipefail
    for signal in 15 9; do
        get_running_pids | while read exe pid; do
            echo "Sending '$exe' pid $pid signal $signal"
            if [ "$pid" = "$start_stop_pid" ]; then
                /sbin/start-stop-daemon -K -s $signal -p $PID_FILE
            else
                /bin/kill -$signal $pid
            fi
        done
        if [ $? -eq 0 ]; then
            if [ $signal -eq 15 ]; then
                echo "$DAEMON is already stopped"
                rc=1
            fi
            break 2
        fi
        sleep 1
    done

    rc=0
    get_running_pids | while read exe pid; do
        logger -t "$LOG_TAG" -p local0.info "Failed to stop $NAME; $exe is still running as pid $pid!"
        echo "Warning: $exe is still running as pid $pid!"
    done
    return $?
}

status_ipmi() {
    set -o pipefail
    get_running_pids | while read exe pid; do
        echo "$exe is running as pid $pid"
    done
    if [ $? -eq 0 ]; then
        echo "$DAEMON is stopped"
    fi
    return 0
}

usage() {
    prog=$0
    echo "Usage: $prog start|stop|status"
    exit 255
}

if [ $# -ne 1 ]; then
    usage $0
fi

case "$1" in
start)
    start_ipmi
    rc=$?
    ;;

stop)
    stop_ipmi
    rc=$?
    ;;

status)
    status_ipmi
    rc=$?
    ;;

*)
    echo "Invalid argument - $1"
    usage $0
    rc=2
    ;;
esac

exit $rc
