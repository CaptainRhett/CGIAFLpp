NAME=snmpd
DAEMON=/sbin/$NAME
PID_FILE=/var/run/$NAME.pid
PARMS="-p $PID_FILE udp:161 udp6:161"
LOG_TAG="snmpd-init"
LOGEXEC=/etc/monit/scripts/log-exec.sh
LOG_CFG=/nv/daemon-log.cfg
SNMPD_LOG=/var/log/${NAME}.log
SNMPD_LOG_EN=0
if [ -f $LOG_CFG ]; then
    SNMPD_LOG_EN=$(grep -c "^SNMPD_LOG_EN=1" $LOG_CFG)
fi

start() {
    ENABLED=$(sed -n 's/SNMPD=\([0|1]\).*$/\1/p' /nv/service.conf)
    if [ $ENABLED -eq 0 ]; then
        monit unmonitor snmpd
        logger -t "$LOG_TAG" -p local0.info "SNMP is disabled in /nv/service.conf - unmonitoring $EXEC"
        return 1
    fi

    if [ $(ps | grep -c '[Ss]nmpd -p') -eq 0 ]; then
        logger -t "$LOG_TAG" -p local0.info "Starting BMC Service $NAME"
        if [ $SNMPD_LOG_EN -eq 1 ]; then
            /sbin/start-stop-daemon -S -p $PID_FILE -m -x $LOGEXEC -- -l $SNMPD_LOG -e $DAEMON -- $PARMS && return 0
        else
            /sbin/start-stop-daemon -S -p $PID_FILE -m -x $DAEMON -- $PARMS && return 0
        fi
        rc=$?
        reason="Unable to execute $DAEMON; rc: $rc"
    else
        reason="$NAME daemon is already running"
    fi
    logger -t "$LOG_TAG" -p local0.info "Failed to start $NAME; $reason"
    return 1
}    

stop() {
    logger -t "$LOG_TAG" -p local0.info "Shutting down BMC Service $NAME"
    for signal in 15 9; do
        /sbin/start-stop-daemon -K -s $signal -p $PID_FILE
        sleep 1
        pid=$(ps | grep '[Ss]nmpd -p' | awk '{print $1}')
        if [ -n "$pid" ]; then
            kill -$signal $pid
            sleep 1
        fi
        if [ $(ps | grep -c '[Ss]nmpd -p') -eq 0 ]; then
            logger -t "$LOG_TAG" -p local0.info "Successful shutdown of BMC Service $NAME"
            return 0
        fi
    done
    logger -t "$LOG_TAG" -p local0.info "Failed to stop $NAME: $(ps | grep '[Ss]nmpd -p')"
    return 1
}

case "$1" in
    start)
    start
    ;;
    stop)
    stop
    ;;
    status)
    echo "Checking $NAME daemon status: "
    ps | grep '[Ss]nmpd -p' || echo "stopped"
    ;;
    restart)
    stop
    start
    ;;
    *)
    echo "Usage: $0 {start|stop|status|restart}"
    exit 1
    ;;
esac
exit $?
