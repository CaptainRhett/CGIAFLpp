#!/bin/sh

NAME=biosoob
DAEMON=/usr/bin/$NAME
PID_FILE=/var/run/$NAME.pid
LOG_TAG=biosoob-init

start_biosoob() {
    if [ $(ps | grep -c '[b]iosoob$') -eq 0 ]; then
        logger -t "$LOG_TAG" -p local0.info "Starting BMC Service $NAME"
        /sbin/start-stop-daemon -S -p $PID_FILE -m -b -x $DAEMON && return 0

        rc=$?
        reason="Unable to execute $DAEMON; rc: $rc"
    else
        reason="$NAME daemon is already running"
    fi
    logger -t "$LOG_TAG" -p local0.info "Failed to start $NAME; $reason"
    return 1
}

stop_biosoob() {
    logger -t "$LOG_TAG" -p local0.info "Shutting down BMC Service $NAME"
    for signal in 15 9; do
        /sbin/start-stop-daemon -K -s $signal -p $PID_FILE
        sleep 1
        pid=$(ps | grep '[b]iosoob$' | awk '{print $1}')
        if [ -n "$pid" ]; then
            kill -$signal $pid
            sleep 1
        fi
        if [ $(ps | grep -c '[b]iosoob$') -eq 0 ]; then
            logger -t "$LOG_TAG" -p local0.info "Successful shutdown of BMC Service $NAME"
            return 0
        fi
    done
    logger -t "$LOG_TAG" -p local0.info "Failed to stop $NAME: $(ps | grep '[b]iosoob$')"
    return 1
}

case "$1" in
    start)
    start_biosoob
    ;;

    stop)
    stop_biosoob
    ;;

    status)
    echo "Checking $NAME daemon status: "
    ps | grep '[b]iosoob$' || echo "stopped"
    ;;

    restart)
    stop_biosoob
    start_biosoob
    ;;

    *)
    echo "Usage: $0 {start|stop|status|restart}"
    exit 1
    ;;
esac
exit $?
