#!/bin/sh

NAME=rftaskd
DAEMON=/usr/bin/$NAME
PID_FILE=/tmp/redfish/$NAME.pid
LOG_TAG="rftaskd-init"
LOGEXEC=/etc/monit/scripts/log-exec.sh
RFTASKD_LOG=/var/log/${NAME}.log
LOG_CFG=/nv/daemon-log.cfg
RFTASKD_LOG_EN=0
if [ -f $LOG_CFG ]; then
    WEBSOCK_LOG_EN=$(grep -c "^RFTASKD_LOG_EN=1" $LOG_CFG)
fi

start() {
    if [ $(ps | grep -c -w '[r]ftaskd$') -eq 0 ]; then
        logger -t "$LOG_TAG" -s -p user.info "Starting $NAME daemon"
        if [ $WEBSOCK_LOG_EN -eq 1 ]; then
            /sbin/start-stop-daemon -S -p $PID_FILE -m -b -x $LOGEXEC -- -l $RFTASKD_LOG -e $DAEMON && return 0
        else
            /sbin/start-stop-daemon -S -p $PID_FILE -m -b -x $DAEMON && return 0
        fi
        rc=$?
        reason="Unable to execute $DAEMON; rc: $rc"
    else
        reason="$NAME daemon is already running"
    fi
    logger -t "$LOG_TAG" -s -p user.info "Failed to start $NAME; $reason"
    return 1
}

stop() {
    logger -t "$LOG_TAG" -s -p user.info "Shutting down $NAME daemon"
    for signal in 15 9; do
        /sbin/start-stop-daemon -K -s $signal -p $PID_FILE
        sleep 1
        pid=$(ps | grep '[r]ftaskd$' | awk '{print $1}')
        if [ -n "$pid" ]; then
            kill -$signal $pid
            sleep 1
        fi
        if [ $(ps | grep -c '[r]ftaskd$') -eq 0 ]; then
            return 0
        fi
    done
    logger -t "$LOG_TAG" -s -p user.info "Failed to stop $NAME: $(ps | grep '[r]ftaskd$')"
    return 1
}

case "$1" in
    start)
    start
    ;;
    stop)
    stop
    ;;
    status)
    echo "Checking $NAME daemon status: "
    ps | grep '[r]ftaskd$' || echo "stopped"
    ;;
    restart)
    stop
    start
    ;;
    *)
    echo "Usage: $0 {start|stop|status|restart}"
    exit 1
    ;;
esac
exit $?
