LOG_TAG=rcD


FW_PRODUCT_ID=$(sed -n 's/.*fwproductid=\([[:alnum:]]*\).*$/\1/p' /proc/cmdline)
SAFE_MODE=$(sed -n 's/.*safemode=\([[:alnum:]]*\).*$/\1/p' /proc/cmdline)

if [ "$FW_PRODUCT_ID" = "008d" -a "$SAFE_MODE" = "jumper" ]; then
    SAFE_MODE="off"
fi


if [ "$SAFE_MODE" = "off" ]; then
    logger -t $LOG_TAG -p local0.info "`date +"%D %T"`: Shutting down BMC Services!"
    killall monit # kill monit first to prevent restart of other services

    ##################################################
    # Shutdown daemons that have external connections
    # first so they can properly close them.
    for svc in usb uima uiso ikvm httpd sol jtagsvr rcmd biosoob upnpd ipmid all rngd upnpd; do
        /etc/monit/scripts/${svc}-init stop > /dev/null 2>&1 &
    done
else
    /etc/init.d/usb-safe stop
    killall -15 ipmidSafe
fi


tries=10
while [ $tries -gt 0 ]; do
    remain=$(ps | awk '/[u]sb$|\/usr\/bin\/[i]pmid|[l]ighttpd -f|[i]kvmserver/ {print $5}')
    if [ -z "$remain" ]; then                                                       
        break;
    fi
    logger -t $LOG_TAG -p local0.info "`date +"%D %T"`: Waiting for services to terminate: $remain"
    sleep 0.5
    let tries--
done
logger -t $LOG_TAG -p local0.info "`date +"%D %T"`: Unmounting file systems!"
/bin/umount -a -r
logger -t $LOG_TAG -p local0.info "`date +"%D %T"`: Shutdown complete!"
