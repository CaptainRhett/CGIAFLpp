<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html>
<head>
    <META http-equiv="Content-Type" content="text/html; charset=utf-8">
    <META HTTP-EQUIV="Pragma" CONTENT="no_cache">
    <META NAME="Insyde Software" CONTENT="(c) 2019 - Insyde Software">
    <title></title>
    <link rel="stylesheet" href="../dflt-css/base.css" type="text/css">
    <link rel="stylesheet" href="../css/basic.css" type="text/css">
    <script language="javascript" src="../js/lang_include.js"></script>
    <script language="javascript" src="../js/utils.js"></script>
    <script language="javascript" src="../js/inputvalidation.js"></script>
    <script language="javascript" src="../js/vm_webiso.js"></script>
    <link rel="stylesheet" type="text/css" href="/css/dummy.css">
</head>
<body>
    <span class="LoadingStyle" id="loading"></span>
    <table border="0" cellpadding="0" cellspacing="5" width="500">
        <tr>
            <td width="20px"><img src="../images/arrow_red.gif" border="0" class="redarrow"></td>
            <td>
                <div id="div_caption" class="mtitle"></div>
            </td>
            <td></td>
        </tr>
        <tr>
        <td></td>
            <td>
                <div id="kcs_segment_state" class="Categorytext"></div>
            </td>
        </tr>
        <td></td>
        <td>
            <table border="0" cellpadding="0" cellspacing="5" width="500">
                <tr>
                    <td class="content_session">
                        <!-- below area is needed to modify by yourself -->
                        <div>
                            <div>
                                <table cellspacing="0" cellpadding="3" border="0" width="80%">
                                    <tr>
                                        <td align="left" width="170px" class="labelhead">
                                            <div id="div_device"></div>
                                        </td>
                                        <td align="left"><label id="dev_stat" class="labelhead"></label></td>
                                    </tr>
                                    <!--<tr>
                                        <td align="left" width="170px" class="labelhead">
                                            <div id="div_device4"></div>
                                        </td>
                                        <td align="left"><label id="dev4_stat" class="labelhead"></label></td>
                                    </tr>-->
                                    <tr>
                                        <td><input type="button" class="btnStyle" id="refresh_status_btn"/></td>
                                    </tr>
                                    <tr>
                                        <td colspan="2">
                                            <hr>
                                        </td>
                                    </tr>
                                </table>

                                <table cellspacing="0" cellpadding="3" border="0" width=auto>
                                    <tr>
                                        <td width="120px" class="labelhead">
                                            <div id="div_type"></div>
                                        </td>
                                        <td width="40px"><select id="mount_type">
                                                <option value="cifs://">Samba</option>
                                                <option value="nfs://">NFS</option>
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td  width="120px" class="labelhead">
                                            <div id="div_host"></div>
                                        </td>
                                        <td><input type="text" id="share_host" maxlength=127 /></td>
                                    </tr>
                                    <tr>
                                        <td width="120px" class="labelhead">
                                            <div id="div_path"></div>
                                        </td>
                                        <td><input type="text" id="path_argument" maxlength=127 />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="120px" class="labelhead">
                                            <div id="div_user"></div>
                                        </td>
                                        <td><input type="text" id="user_argument" maxlength=127 /></td>
                                    </tr>
                                    <tr>
                                        <td width="120px" class="labelhead">
                                            <div id="div_pwd"></div>
                                        </td>
                                        <td><input type="password" id="pwd_argument" maxlength=127 /></td>
                                    </tr>
                                </table>
                                <br>
                                <div>
                                    <input type="button" class="btnStyle" id="save_btn"/>
                                    <input type="button" class="btnStyle" id="mount_btn"/>
                                    <input type="button" class="btnStyle" id="unmount_btn"/>
                                </div>


                            </div>
                        </div>

                        <!-- end of this area -->
                    </td>
                <tr>
            </table>
        </td>
    <tr>
</table>
</body>
</html>
