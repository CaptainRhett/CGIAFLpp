<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <META http-equiv="Content-Type" content="text/html; charset=utf-8">
    <META HTTP-EQUIV="Pragma" CONTENT="no_cache">
    <META NAME="Insyde Software" CONTENT="(c) 2014 - Insyde Software">
    <title></title>
    <link rel="stylesheet" href="../dflt-css/base.css" type="text/css">
    <link rel="stylesheet" href="../css/basic.css" type="text/css">
    <script language="javascript" src="../js/utils.js"></script>
    <script language="javascript" src="../js/config_fw_update.js"></script>
    <link rel="stylesheet" type="text/css" href="/css/dummy.css">
</head>
<body>
<span class="LoadingStyle" id="loading"></span>
<table border="0" cellpadding="0" cellspacing="0" class="content_table">
	<tr><td width="20px"><img src="../images/arrow_red.gif" border="0" class="redarrow"></td>
        <td><div id="submenu_div" class="mtitle"></div></td></tr>
    <tr><td colspan="2"><div id="kcs_segment_state" class="Categorytext"></div></td></tr>
</table>
<p id="desc_p" class="text_desc"></p>
<br>
    <fieldset class="widel group">
        <legend id="submenu_legend" class="legendcaption"></legend>
          <div id="inputControlsMessage" class="nodisplay"></div>
          <div id="inputControls" class="lignleft">
            <table cellspacing="0" cellpadding="5" border="0" width="100%">
                <tr>
                    <td class="bold">
                        <span id="fw_rev_span" class="nowrap"></span>
                    </td>
                    <td>
                        <label id="curFwVer">...</label>
                    </td>
                </tr>
                <tr>
                    <td class="bold">
                        <span id="build_time_span" class="nowrap"></span>
                    </td>
                    <td>
                        <label id="curFwTS">...</label>
                    </td>
                </tr>
                <tr id="BMCPFMActiveTr">
                    <td class="bold">
                        <span id="bmc_pfm_active_span" class="nowrap"></span>
                    </td>
                    <td>
                        <label id="BMCPFMActive">...</label>
                    </td>
                </tr>
                <tr id="BMCPFMRecoveryTr">
                    <td class="bold">
                        <span id="bmc_pfm_recovery_span" class="nowrap"></span>
                    </td>
                    <td>
                        <label id="BMCPFMRecovery">...</label>
                    </td>
                </tr>
                <tr id="BMCUpdateOption">
                    <td><label id="bmc_update_lbl" class="labelhead bold">...
                        </label>
                    </td>
                    <td>
                        <input type="checkbox" id="bmc_backup_check"><span id="bmc_backup_option">...</span>
                        <input type="checkbox" id="bmc_nvram_check"><span id="bmc_nvram_option">...</span>
                        <input type="checkbox" id="bmc_immediately_check"><span id="bmc_immediately_option">...</span>
                    </td>
                </tr>
                <tr id="fwUpdButtons">
                    <td><label id="drop_file" class="labelhead bold">...
                        </label>
                    </td>
                    <td>
                        <table cellspacing="0" cellpadding="5" border="0">
                            <tr>
                                <td>
                                    <div class="fileChooser">
                                        <input type="file" name="temp" id="FileBrowse" accept=".bin"/>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="btnTray">
                                        <input type="button" class="classicBtn" id="uploadBtn" />
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr id="fwUpdStatus">
                    <td colspan="2">
                        <div id="fwupload">
                            <span id="fwupload-label">
                            </span>
                            <span id="fwupload-value">
                            </span>
                        </div>
                        <div id="fwauthenticate">
                            <span id="fwauthenticate-label">
                            </span>
                            <span id="fwauthenticate-value">
                            </span>
                        </div>
                        <div id="fwprogram">
                            <span id="fwprogram-label">
                            </span>
                            <span id="fwprogram-value">
                            </span>
                        </div>
                        <div id="fwready">
                            <span id="fwready-label">
                            </span>
                            <span id="fwready-value">
                            </span>
                        </div>
                        <div id="fwmsg">
                            <span id="fwmsg-value">
                            </span>
                        </div>
                        <div id="fwerror">
                            <span id="fwerror-label">
                            </span>
                            <span id="fwerror-value">
                            </span>
                            <input type="button" class="classicBtn" id="resetBtn" />
                        </div>
                    </td>
                </tr>
            </table>
            <div id="fwImmediatelyUpdStatus">
                <td><label id="fw-immediately-msg" class="labelhead bold">
                    </label>
                </td>
            </div>
      </div>
    </fieldset>
</body>
</html>

