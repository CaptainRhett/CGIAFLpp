<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html>
<head>
    <META http-equiv="Content-Type" content="text/html; charset=utf-8">
    <META HTTP-EQUIV="Pragma" CONTENT="no_cache">
    <META NAME="Insyde Software" CONTENT="(c) 2014 - Insyde Software">
    <title></title>
    <link rel="stylesheet" href="../dflt-css/base.css" type="text/css">
    <link rel="stylesheet" href="../css/basic.css" type="text/css">
    <script language="javascript" src="../js/utils.js"></script>
    <script language="javascript" src="../js/config_vlan.js"></script>
    <script language="javascript" src="../js/inputvalidation.js"></script>
    <script language="javascript" src="../../js/iframe_event.js"></script>
    <link rel="stylesheet" type="text/css" href="/css/dummy.css">
</head>
    <body>
    <span class="LoadingStyle" id="loading"></span>
    <table border="0" cellpadding="0" cellspacing="5" class="content_table">
        <tr><td width="20px"><img src="../images/arrow_red.gif" border="0" class="redarrow"></td>
            <td><div id="vlan_setting_div" class="mtitle"></div></td>
        </tr>
        <tr><td><br></td><td><div id="kcs_segment_state" class="Categorytext"></div></td></tr>
        <tr><td>&nbsp;</td><td>
        <table border="0" id="table2">
            <tr>
                <td><label id="lan_channel_lbl" class="labelhead"></label></td>
                <td><select id="_lanChannel" class="labelhead">
                        <option value="channel_unknow">Unknow</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td>
                    <input type="checkbox" id="_enableVLAN" value="1"/>
                        <label id="vlan_enable_lbl" class="labelhead"></label>
                </td>
            </tr>
            <tr>
                <td>
                    <label id="vlan_id_lbl" class="labelhead"></label>
                </td>
                <td>
                    <input type="text" id="_vlanID" disabled class="labelhead"/>
                </td>
            </tr>
            <tr>
                <td>
                    <label id="vlan_priority_lbl" class="labelhead"></label>
                </td>
                <td>
                    <input type="text" id="_vlanPriority" disabled class="labelhead"/>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="btnTray"><input type="button" class="classicBtn" id="_save"/></div>
                    </div>
                </td>
            </tr>
        </table>
        </td></tr>
    </table>
    </body>
</html>
