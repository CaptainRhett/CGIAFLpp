<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <META http-equiv="Content-Type" content="text/html; charset=utf-8">
    <META HTTP-EQUIV="Pragma" CONTENT="no_cache">
    <META NAME="Insyde Software" CONTENT="(c) 2014 - Insyde Software">
    <title></title>
    <link rel="stylesheet" href="../dflt-css/base.css" type="text/css">
    <link rel="stylesheet" href="../css/basic.css" type="text/css">
    <link rel="stylesheet" href="../css/container.css" type="text/css">
    <link rel="stylesheet" href="../css/grid/listgrid.css" type="text/css">
    <script language="javascript" src="../js/generalTableController.js"></script>
    <script language="javascript" src="../js/lang_include.js"></script>
    <script language="javascript" src="../js/utils.js"></script>
    <script language="javascript" src="../../js/iframe_event.js"></script>
    <script language="javascript" src="../js/config_ad.js"></script>
    <script language="javascript" src="../js/config_ad_advanced.js"></script>
    <link rel="stylesheet" type="text/css" href="/css/dummy.css">
</head>
<body>
    <span class="LoadingStyle" id="loading"></span>
    <table border="0" cellpadding="0" cellspacing="5" class="content_table">
        <tr><td width="20px"><img src="../images/arrow_red.gif" border="0" class="redarrow"></td><td>
            <div id="div_caption" class="mtitle"></div>
        </td></tr>
        <tr><td><br></td><td colspan="3"><br></td></tr>
        <tr><td></td><td class="labelhead container-flex">
            <table border="0">
                <tr><td colspan="2">
                    <input type="checkbox" name="enableAD" id="enableAD"/>
                    <label id="adadv_enable" class="labelhead" for="enableAD"></label></td></tr>
                <tr><td colspan="2">
                    <input type="checkbox" name="enableSSL" id="enableSSL"/>
                    <label id="ad_auth_ssl" class="labelhead" for="enableSSL"></label></td></tr>
                <tr><td>
                    <span id="lanb_adv_port" class="labelhead"></span></td><td>
                    <input type="text" id="ad_port" maxlength="10" name="ad_port" /></td></tr>
                <tr><td>
                    <span id="userdomain" class="labelhead"></span></td><td>
                    <input type="text" id="userDomain" maxlength="64" name="userDomain" /></td></tr>
                <tr><td>
                    <span id="sp_timeout" class="labelhead"></span></td><td>
                    <input type="text" id="timeout" name="timeout" /></td></tr>
                <tr><td>
                    <span id="advsrv1" class="labelhead"></span></td><td>
                    <input type="text" id="adServer1" name="adServer1" /></td></tr>
                <tr><td>
                    <span id="advsrv2" class="labelhead"></span></td><td>
                    <input type="text" id="adServer2" name="adServer2" /></td></tr>
                <tr><td>
                    <span id="advsrv3" class="labelhead"></span></td><td>
                    <input type="text" id="adServer3" name="adServer3" /></td></tr>
            </table>
        </td></tr>
        <tr><td></td><td>
                <input type="button" class="btnStyle" id="saveBtn" name="saveBtn">
        </td></tr>
        <tr><td></td><td>
            <div class="cfgAdTbl TableInfo" id="adGroupListInfo"></div>
        </td></tr>
        <tr><td></td><td>
            <table border="0" cellpadding="0" cellspacing="0" class="cfgAdTbl">
                <tr><td>
                <div id="adGroupListTbl"></div>
                <br>
                <input type="button" class="btnStyle" id="addGroupBtn" name="addGroupBtn" value="">
                <input type="button" class="btnStyle" id="modGroupBtn" name="modGroupBtn" value="">
                <input type="button" class="btnStyle" id="delGroupBtn" name="delGroupBtn" value="">
                </td></tr>
            </table>
        </td></tr>
    </table>
</body>
</html>
