<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html>
<head>
    <META http-equiv="Content-Type" content="text/html; charset=utf-8">
    <META HTTP-EQUIV="Pragma" CONTENT="no_cache">
    <META NAME="Insyde Software" CONTENT="(c) 2014 - Insyde Software">
    <title></title>
    <link rel="stylesheet" href="../dflt-css/base.css" type="text/css">
    <link rel="stylesheet" href="../css/basic.css" type="text/css">
    <script language="javascript" src="../js/utils.js"></script>
    <script language="javascript" src="../js/inputvalidation.js"></script>
    <script language="javascript" src="../../js/iframe_event.js"></script>
    <script language="javascript" src="../../js/config_ipv4.js"></script>
    <link rel="stylesheet" type="text/css" href="/css/dummy.css">
</head>
<body>
    <span class="LoadingStyle" id="loading"></span>
    <table border="0" cellpadding="0" cellspacing="5" width="500">
        <tr>
            <td width="20px"><img src="../images/arrow_red.gif" border="0" class="redarrow"></td>
            <td>
                <div id="caption_div" class="mtitle"></div>
            </td>
            <td></td>
        </tr>
    </table>

    <table border="0" cellpadding="0" cellspacing="5" width="500">
        <tr class="novis">
            <td width="20px"><img src="../images/arrow_red.gif" border="0" class="redarrow"></td>
            <td>
                <div id="test_caption_div" class="mtitle"></div>
            </td>
            <td></td>
        </tr>
        <tr class="enable_host_interface">
            <td width="20px"></td>
            <td width="160px"><label id="host_interface_lbl" class="labelhead"></label></td>
            <td>
                <input type="checkbox" id="_enableHostinterface" value="0"/>
            </td>
        </tr>
        <td></td>
    </table>

    <table border="0" cellpadding="0" cellspacing="5" width="500">
        <tr>
            <td></td>
            <td colspan="2"><div id="kcs_segment_state" class="Categorytext"></div></td>
        </tr>
        <tr class="enable_lan_failover">
            <td width="20px"></td>
            <td width="160px"><label id="failover_lbl" class="labelhead"></label></td>
            <td>
                <input type="checkbox" id="_enableLanFailover" value="1"/>
            </td>
        </tr>
    </table>

    <table id="bonding_tb" class="nodisplay"  border="0" cellpadding="0" cellspacing="5" width="500">
        <tr>
            <td width="20px"></td>
            <td width="20px"></td>
            <td><label id="bonding_channel_lbl" class="labelhead"></label></td>
            <td id="chbod_1"><label id="channel1_lbl" class="labelhead"></label>
                <input type="checkbox" id="_b1" value="1"/>
            </td>
            <td id="chbod_2"><label id="channel2_lbl" class="labelhead"></label>
                <input type="checkbox" id="_b2" value="2"/>
            </td>
            <td id="chbod_3"><label id="channel3_lbl" class="labelhead"></label>
                <input type="checkbox" id="_b3" value="3"/>
            </td>
        </tr>
        <tr>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td>
                <label id="primary_channel_lbl" class="labelhead"></label>
            </td>
            <td>
                <select id="_pChannel" class="labelhead">
                </select>
            </td>
            <td></td>
            <td></td>
        </tr>
    </table>

    <table border="0" cellpadding="0" cellspacing="5" class="content_table">
        <tr>
            <td></td>
            <td>
                <fieldset  class="wide group">
                    <legend id="network_legen" class="legendcaption"></legend>
                    <table border ="0" cellspacing ="0" cellpadding ="0" width ="100%">
                        <tr><td>&nbsp;</td></tr>
                        <tr><td width ="25px">&nbsp;</td>
                            <td width ="150">
                            <label id="hostname_lbl" class="labelhead">
                            </label>
                            </td>
                            <td>
                                <input type="text" id="_hostname" class="labelhead" maxlength=63 />
                            </td>
                        </tr>
                        <tr><td>&nbsp;</td><td></td><td></td></tr>
                        <tr><td width ="25px">&nbsp;</td>
                            <td width ="150">
                                <label id="network_lbl" class="labelhead">
                                </label>
                            </td>
                            <td>
                                <select id="_lanChannel" class="labelhead">
                                  <option value="channel_unknow">Unknow</option>
                                </select>
                            </td>
                        </tr>
                        <tr><td>&nbsp;</td><td></td><td></td></tr>
                        <tr><td width ="25px">&nbsp;</td>
                            <td width ="150">
                                <label id="mac_addr_lbl" class="labelhead">
                                </label>
                            </td>
                            <td>
                                <input type="text" id="_macAddress" disabled class="labelhead"/>
                            </td>
                        </tr>
                        <tr><td>&nbsp;</td><td></td><td></td></tr>
                        <tr><td width ="25px">&nbsp;</td>
                            <td width ="150">
                                <label id="nic_desc_lbl" class="labelhead">
                                </label>
                            </td>
                            <td>
                                <span type="text" class="bold" id="nic_Description" class="labelhead"></span>
                            </td>
                        </tr>
                        <tr><td>&nbsp;</td><td></td><td></td></tr>
                        <tr><td width ="25px">&nbsp;</td>
                            <td width ="150">
                                <label id="link_status_lbl" class="labelhead">
                                </label>
                            </td>
                            <td>
                                <span type="text" class="bold" id="link_status" class="labelhead"></span>
                            </td>
                        </tr>
                        <tr><td>&nbsp;</td><td></td><td></td></tr>
                        <tr>
                        <td></td>
                            <td width ="150" colspan="2" class="labelhead">
                                <input type="radio" name="optNW" id="_optDHCP" />
                                    <label id="optDHCP_lbl"></label>
                                <p>
                                <input type="radio" name="optNW" id="_optStatic" />
                                    <label id="optStatic_lbl"></label>
                                <p>
                                <input type="radio" name="optNW" id="_optDisable" />
                                    <label id="optDisable_lbl"></label>
                                <p>
                            </td>
                        </tr>
                        <tr><td>&nbsp;</td><td></td><td></td></tr>
                        <tr><td width ="25px">&nbsp;</td>
                            <td width ="150">
                                <label id="ip_addr_lbl" class="labelhead">
                                </label>
                            </td>
                            <td>
                                <input type="text" id="_ipAddress" class="labelhead"/>
                            </td>
                        </tr>
                        <tr><td>&nbsp;</td><td></td><td></td></tr>
                        <tr><td width ="25px">&nbsp;</td>
                            <td width ="150">
                                <label id="mask_lbl" class="labelhead">
                                </label>
                            </td>
                            <td>
                                <input type="text" id="_subnetMask" class="labelhead"/>
                            </td>
                        </tr>
                        <tr><td>&nbsp;</td><td></td><td></td></tr>
                        <tr><td width ="25px">&nbsp;</td>
                            <td width ="150">
                                <label id="gateway_lbl" class="labelhead">
                                </label>
                            </td>
                            <td>
                                <input type="text" id="_gateway" class="labelhead"/>
                            </td>
                        </tr>
                        <tr><td>&nbsp;</td><td></td><td></td></tr>
                        <tr><td width ="25px">&nbsp;</td>
                            <td width ="150">
                                <label id="dns_pri_lbl" class="labelhead">
                                </label>
                            </td>
                            <td>
                                <input type="text" id="_primaryDNS"  class="labelhead"/>
                            </td>
                        </tr>
                        <tr><td>&nbsp;</td><td></td><td></td></tr>
                        <tr><td width ="25px">&nbsp;</td>
                            <td width ="150">
                                <label id="dns_sec_lbl" class="labelhead">
                                </label>
                            </td>
                            <td>
                                <input type="text" id="_secondDNS"  class="labelhead"/>
                            </td>
                        </tr>
                        <tr><td>&nbsp;</td></tr>
                    </table>
                </fieldset>
            </td>
        </tr>
    </table>

    <table border="0" cellpadding="0" cellspacing="5" width="500">
        <tr>
            <td colspan="3">
                <div class="btnTray">
                    <input type="button" class="classicBtn" id="_save"/>
                </div>
            </td>
        </tr>
    </table>
</body>
</html>
