<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <META http-equiv="Content-Type" content="text/html; charset=utf-8">
    <META HTTP-EQUIV="Pragma" CONTENT="no_cache">
    <META NAME="Insyde Software" CONTENT="(c) 2014 - Insyde Software">
    <title></title>
    <link rel="stylesheet" href="../dflt-css/base.css" type="text/css">
    <link rel="stylesheet" href="../css/basic.css" type="text/css">
    <script language="javascript" src="../js/utils.js"></script>
    <script language="javascript" src="../js/servd_sol_log.js"></script>
    <script language="javascript" src="../../js/iframe_event.js"></script>
    <script src="../js/ansi_up.js" type="text/javascript"></script>

    <link rel="stylesheet" type="text/css" href="/css/dummy.css">
</head>
<body>
   <span class="LoadingStyle" id="loading"></span>
   <table border="0" cellpadding="0" cellspacing="5" class="content_table" >
        <tr><td width="20px"><img src="../images/arrow_red.gif" border="0" class="redarrow"></td>
            <td><div id="sol_log_div" class="mtitle"></div></td></tr>
        <tr><td></td>
            <td><div id="kcs_segment_state" class="Categorytext"></div></td></tr>
        <tr>
            <td></td>
            <td>
            <fieldset class="group widepl">
                                <legend id="enable_log_legend" class="legendcaption"></legend>
                <table border="0" cellpadding="0" cellspacing="5" class="content_table">
                    <tr>
                        <td>
                        <input type="checkbox" id="sollogcbx"/>
                        <label id="enable_log_lbl" class="labelhead">
                        </label>
                        <td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>
                        <input type="button" name="setSOLconf" id="setSOLconfBtn">
                        </td>
                    </tr>
                </table>
            </fieldset>
            </td>
        </tr>
        <tr><td>&nbsp;</td><td>&nbsp;</td></tr>
        <tr>
            <td></td>
            <td>
            <fieldset class="group widepl">
                                <legend id="caption_legend" class="legendcaption"></legend>
                <table border="0" cellpadding="0" cellspacing="5" class="content_table">
                    <tr>
                        <td>
                            <div id="postBox"></div>
                            <fieldset id="solLogViewFS" class="group">
                            <legend id="log_view_legend" class="legendcaption">
                            </legend>
                            <div id="solLogView"></div>

                            <pre id="sollogConsole" ></pre>
                            </fieldset>
                        <td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td>
                        <input type="button" id="exportSOLLogBtn">
                        </td>
                    </tr>
                </table>
            </fieldset>
            </td>
        </tr>
        <tr>
            <td><br></td>
            <td></td>
        </tr>
        <tr><td>&nbsp;</td><td>&nbsp;</td></tr>
        <tr>
            <td></td>
            <td></td>
        </tr>
    </table>
</body>
</html>
