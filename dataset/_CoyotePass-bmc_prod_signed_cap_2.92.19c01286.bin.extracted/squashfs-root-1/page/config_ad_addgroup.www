<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <META http-equiv="Content-Type" content="text/html; charset=utf-8">
    <META HTTP-EQUIV="Pragma" CONTENT="no_cache">
    <META NAME="Insyde Software" CONTENT="(c) 2014 - Insyde Software">
    <title></title>
    <!-- common css -->
    <link rel="stylesheet" href="../dflt-css/base.css" type="text/css">
    <link rel="stylesheet" href="../css/basic.css" type="text/css">
    <link rel="stylesheet" href="../css/grid/listgrid.css" type="text/css">
    <!--common javascipt library -->
    <script language="javascript" src="../js/lang_include.js"></script>
    <script language="javascript" src="../js/utils.js"></script>
    <script language="javascript" src="../../js/iframe_event.js"></script>
    <script language="javascript" src="../js/config_ad_addgroup.js"></script>
    <link rel="stylesheet" type="text/css" href="/css/dummy.css">
</head>
<body>
    <span class="LoadingStyle" id="loading"></span>
    <table border="0" cellpadding="0" cellspacing="0"  class="content_table">
        <tr><td width="20px"><img src="../images/arrow_red.gif" border="0" class="redarrow"></td>
            <td>
                <div id="caption" class="mtitle"></div>
            </td>
        </tr>
        <tr>
            <td><br></td>
            <td><br></td>
        </tr>
        <tr>
            <td></td>
            <td>
                <!-- below area is needed to modify by yourself -->
                <table border="0">
                    <tr>
                        <td><span id="adname" class="labelhead"></span></td>
                        <td><input type="text" id="adGroupName" name="adGroupName" /></td>
                    </tr>
                    <tr>
                        <td><span id="domain" class="labelhead"></span></td>
                        <td><input type="text" id="adGroupDomain" name="adGroupDomain" /></td>
                    </tr>
                    <tr>
                        <td><span id="priv" class="labelhead"></span></td>
                        <td>
                            <select id="adGroupPriv" name="adGroupPriv">
                                <option id="opt4" value="4"></option>
                                <option id="opt3" value="3"></option>
                                <option id="opt2" value="2"></option>
                                <option id="optf" value="0xf"></option>
                            </select>
                        </td>
                    </tr>
                </table>
                <br>
                <input type="button" class="btnStyle" id="addBtn" name="addBtn">
                <input type="button" class="btnStyle" id="cancelBtn" name="cancelBtn">
                <!-- end of this area -->
            </td>
        </tr>
    </table>
</body>
</html>
