<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<html>
<head>
    <META http-equiv="Content-Type" content="text/html; charset=utf-8">
    <META HTTP-EQUIV="Pragma" CONTENT="no_cache">
    <META NAME="Insyde Software" CONTENT="(c) 2014 - Insyde Software">
    <title></title>
    <link rel="stylesheet" href="../dflt-css/base.css" type="text/css">
    <link rel="stylesheet" href="../css/basic.css" type="text/css">
    <script language="javascript" src="../js/utils.js"></script>
    <script language="javascript" src="../../js/iframe_event.js"></script>
    <script language="javascript" src="../js/config_ldap.js"></script>
    <link rel="stylesheet" type="text/css" href="/css/dummy.css">
</head>

<body>
    <span class="LoadingStyle" id="loading"></span>
    <table border="0" cellpadding="0" cellspacing="5" class="content_table">
        <tr><td width="20px"><img src="../images/arrow_red.gif" border="0" class="redarrow"></td>
            <td><div id="caption_div" class="mtitle"></div></td></tr>
        <tr><td><br></td><td colspan="3"><div id="kcs_segment_state" class="Categorytext"></div></td></tr>
        <tr><td><br></td><td>
            <table border="0" width="100%" id="table1">
                <tr>
                    <td>&nbsp;<label><input type="checkbox" id="SwitchLDAP"/>
                    <span id="ldap_en_span" class="labelhead"></span></label></td>
                </tr>
            </table>
            </td></tr>
        <tr><td>&nbsp;</td><td>
            <table border="0" id="table2">
                <tr>
                    <td>&nbsp;<label><input type="checkbox" id="enLDAPSSL"/>
                    <span id="ladp_ssl_span" class="labelhead"></span></label></td>
                </tr>
                <tr>
                    <td>&nbsp;<span id="ldap_port_span" class="labelhead"></span></td>
                    <td width="393">&nbsp;<input type="text" id="LDAPPORT"/></td>
                </tr>
                <tr>
                    <td>&nbsp;<span id="ldap_ip_span" class="labelhead"></span></td>
                    <td width="393">&nbsp;<input type="text" id="LDAPIP"/></td>
                </tr>
                <tr>
                    <td>&nbsp;<span id="ldap_pwd_span" class="labelhead"></span></td>
                    <td width="393">&nbsp;<input type="password" id="LDAPBINDPW"/></td>
                </tr>
                <tr>
                    <td>&nbsp;<span id="ldap_dn_span" class="labelhead"></span></td>
                    <td width="393">&nbsp;<input type="text" maxlength="255" id="LDAPBINDWN"/></td>
                </tr>
                <tr>
                    <td>&nbsp;<span id="ldap_sb_span" class="labelhead"></span></td>
                    <td width="393">&nbsp;<input type="text" maxlength="255" id="LDAPBASE"/></td>
                </tr>
                <tr class="head">
                    <td colspan="2" class="bold"><span id="ldap_gf_header_span" class="labelhead"></span></td>
                </tr>
                <tr>
                    <td>&nbsp;<span id="ldap_gf0_span" class="labelhead"></span></td>
                    <td width="393">&nbsp;<input type="text" maxlength="255" id="ADMINGRPFILTER" width="90%"/></td>
                </tr>
                <tr>
                    <td>&nbsp;<span id="ldap_gf1_span" class="labelhead"></span></td>
                    <td width="393">&nbsp;<input type="text" maxlength="255" id="OPERGRPFILTER" width="90%"/></td>
                </tr>
                <tr>
                    <td>&nbsp;<span id="ldap_gf2_span" class="labelhead"></span></td>
                    <td width="393">&nbsp;<input type="text" maxlength="255" id="USERGRPFILTER" width="90%"/></td>
                </tr>
            </table>
            </td></tr>
        <tr><td height="53"></td>
              <td height="53">
              <!-- below area is needed to modify by yourself -->

              <br>
              <input type="button" class="btnStyle" id="ButtonSave"/>
              <!-- end of this area -->
              </td>
        </table>
</body>
</html>
